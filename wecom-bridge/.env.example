# ============================================================
# WeCom Bridge 配置模板
# 复制为 .env 后填写。注意: 云端(CloudBase)与本地(Mac)是两套环境, 各自一份 .env。
# ============================================================

# ----- 企业微信配置 (两端都要填, 一致) -----
WECOM_CORPID=ww1cc830630137c7ef
WECOM_AGENTID=1000002
WECOM_SECRET=iUyk0qhX1emDM__bXVdmFTNWKFQ-eCsT3CDuNMEMbqM
WECOM_TOKEN=XNB0
WECOM_ENCODING_AES_KEY=TlG6W2TXWdyQ2hOnoJdHzVC2JO9udqtwOzn75E9FgGz

# ----- 服务配置 -----
PORT=3000
# 云端同容器里 server 与 worker 用 127.0.0.1 互通
INTERNAL_BASE_URL=http://127.0.0.1:3000

# ============================================================
# 飞书入口 (免域名长连接收消息, 推荐)
# 在飞书开放平台创建企业自建应用 -> 添加机器人能力 ->
# 事件与回调订阅方式选「使用长连接接收事件」-> 添加事件 im.message.receive_v1
# 权限开通 im:message / im:message:send_as_bot / im:message.p2p_msg:readonly
# 拿到 App ID / App Secret 填下面。无需任何公网域名/证书。
# ============================================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============================================================
# 本地 Mac (隧道客户端) 用的配置
# 本机只跑 tunnel-client, 把本地 Ollama 暴露给云端 bridge。
# ============================================================
# 本地 Ollama (供 tunnel-client 调用)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# 云端 bridge 的反向隧道地址 (改成你的 CloudBase 域名)
TUNNEL_URL=wss://<你的CloudBase域名>/tunnel
TUNNEL_TOKEN=请改成一段随机字符串_云端与本机必须一致

# ============================================================
# 云端 (微信云托管 / CloudBase) 容器环境变量
# 在 CloudBase 控制台「环境变量」里设置以下键值:
# ------------------------------------------------------------
# WECOM_CORPID / WECOM_AGENTID / WECOM_SECRET / WECOM_TOKEN / WECOM_ENCODING_AES_KEY  (同上)
# PORT=3000
# INTERNAL_BASE_URL=http://127.0.0.1:3000
# LLM_MODE=tunnel
# LLM_API_KEY=ollama
# TUNNEL_URL=wss://<同一个CloudBase域名>/tunnel
# TUNNEL_TOKEN=与本地 .env 完全一致 的同一段随机字符串
# ------------------------------------------------------------
# 之后在企微后台「接收消息」回调 URL 填: https://<CloudBase域名>/callback
